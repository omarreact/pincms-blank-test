# Required: local SQLite only. Persistent deployments require persistent volume or a PostgreSQL schema/config.
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_-hex_32"
# REQUIRED for first-time wizard; never publish it to the browser or commit your actual value
PINCMS_SETUP_TOKEN="7bc09e30d61b83dd5b756f37558b1153e93e7becf66167056e1bcc1cd221d088"
# Cloudinary is optional: require all three fields for server-signed uploads.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Local media writes are NOT persistent on serverless hosts. Set Cloudinary for production.
UPLOAD_DIR="./public/uploads"
# Firebase integration needs a server-side Admin service account; public browser config alone is insufficient.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Optional scheduled publishing. Use an external cron to GET /api/cron/publish with Authorization: Bearer TOKEN.
PINCMS_CRON_SECRET=""
