generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Persistent hosting. Use managed PostgreSQL.
  url      = env("DATABASE_URL")
}

// ==================== USERS & AUTH ====================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(EDITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pages         Page[]
  posts         Post[]
  media         Media[]
  accounts      Account[]
  sessions      Session[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== CONTENT ====================
model Page {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  status      Status     @default(DRAFT)
  excerpt     String?
  seoTitle    String?
  seoDesc     String?
  ogImage     String?
  template    String     @default("default")
  parentId    String?
  parent      Page?      @relation("PageHierarchy", fields: [parentId], references: [id])
  children    Page[]     @relation("PageHierarchy")
  order       Int        @default(0)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id])

  blocks      Block[]
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  status      Status   @default(DRAFT)
  excerpt     String?
  content     String?  // Markdown / HTML fallback
  seoTitle    String?
  seoDesc     String?
  ogImage     String?
  featured    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])

  blocks      Block[]
  categories  Category[]
  tags        Tag[]
}

enum Status {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

// ==================== BLOCKS (Core of the editor) ====================
model Block {
  id        String   @id @default(cuid())
  type      String   // hero, text, image, cta, columns, etc.
  data      String   // JSON string of block content
  order     Int      @default(0)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== TAXONOMY ====================
model Category {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?
  posts       Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

// ==================== MEDIA ====================
model Media {
  id          String   @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  alt         String?
  caption     String?
  width       Int?
  height      Int?
  folder      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  uploadedById String?
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id])
}

// ==================== THEMES (JSON-based) ====================
model Theme {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  version     String   @default("1.0.0")
  description String?
  thumbnail   String?
  isActive    Boolean  @default(false)
  // Full theme definition stored as JSON
  config      String   // JSON: layouts, styles, blocks, templates, settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== MENUS ====================
model Menu {
  id        String     @id @default(cuid())
  name      String
  location  String     @unique // header, footer, mobile
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id       String  @id @default(cuid())
  label    String
  url      String?
  pageId   String?
  order    Int     @default(0)
  parentId String?
  parent   MenuItem? @relation("MenuHierarchy", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuHierarchy")
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

// ==================== FORMS ====================
model Form {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  fields      String           // JSON array of field definitions
  settings    String?          // JSON: notifications, success message, etc.
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      String   // JSON of submitted values
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

// ==================== SETTINGS ====================
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON or plain string
}

// ==================== REDIRECTS ====================
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  type      Int      @default(301) // 301 or 302
  createdAt DateTime @default(now())
}

// Tracks imported WordPress IDs so reruns never create duplicate content.
model MigrationRecord {
  id           String   @id @default(cuid())
  sourceSite   String
  sourceType   String
  sourceId     String
  targetId     String
  originalPath String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sourceSite, sourceType, sourceId])
  @@index([sourceSite])
}
