{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pincms-workers-stage",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "PINCMS_RUNTIME": "cloudflare",
    "NEXTAUTH_URL": "https://pincms-workers-stage.farukkhanone.workers.dev"
  },
  "preview_urls": false
}
